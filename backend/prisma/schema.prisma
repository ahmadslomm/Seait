// Seait backend — Prisma schema (matches com.waig.nalo data model)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  uid           Int      @id
  mobile        String?
  nick          String   @default("")
  sex           Int      @default(0)
  sign          String   @default("")
  avatar        String   @default("")
  avatarFrame   String   @default("")
  carFrame      String   @default("")
  chatBubble    String   @default("")
  infoBgImg     String   @default("")
  birthday      String?
  country       String?
  regCountry    String?
  region        String?
  lang          String?
  age           Int      @default(0)
  constellation String?
  audit_avatar  Int      @default(0)
  real_flag     Int      @default(0)
  isAnchor      Boolean  @default(false)
  isPresident   Boolean  @default(false)
  noble_level   Int      @default(0)
  active_level  Int      @default(0)
  gameLv        Int      @default(0)
  svip          Int      @default(0)
  isBanned      Int      @default(0)
  createdAt     DateTime @default(now())
  profile       Profile?
  wallet        Wallet?
  vip           UserVip?
}

model Profile {
  uid            Int    @id
  fans           Int    @default(0)
  subs           Int    @default(0) // following
  gifts          Int    @default(0)
  beans          Int    @default(0)
  photos         Int    @default(0)
  songs          Int    @default(0)
  days           Int    @default(0)
  cost           BigInt @default(0)
  levelName      String @default("")
  nationalFlag   String @default("")
  actTitles      Json?
  user_label     Json?
  medals         Json?
  supporters     Json?
  supporters_num Int    @default(0)
  user           User   @relation(fields: [uid], references: [uid])
}

model Wealth {
  uid             Int    @id
  wealthLv        Int    @default(0)
  wealthExp       BigInt @default(0)
  wealthLimit     BigInt @default(0)
  nextWealthLvExp BigInt @default(0)
  charmLv         Int    @default(0)
  charm           BigInt @default(0)
  level           Int    @default(0)
}

model Wallet {
  uid       Int                 @id
  coins     BigInt              @default(0)
  diamonds  BigInt              @default(0)
  gold      BigInt              @default(0)
  beans     BigInt              @default(0)
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [uid], references: [uid])
  txns      WalletTransaction[]
}

model WalletTransaction {
  id            Int      @id @default(autoincrement())
  uid           Int
  deltaCoins    BigInt   @default(0)
  deltaDiamonds BigInt   @default(0)
  reason        String
  refId         String?
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [uid], references: [uid])
}

model VipLevel {
  level      Int     @id
  name       String
  type       String
  privileges Json?
  frame      String?
}

model NobleLevel {
  level      Int     @id
  name       String
  privileges Json?
  frame      String?
  horn       Int     @default(0)
}

model UserVip {
  uid         Int       @id
  vip_level   Int       @default(0)
  noble_level Int       @default(0)
  expireTime  DateTime?
  user        User      @relation(fields: [uid], references: [uid])
}

model Gift {
  gift_id    Int     @id
  name       String
  icon       String  @default("")
  price      Int     @default(0)
  coin_type  Int     @default(1) // 1 coin 2 diamond
  category   Int     @default(0)
  anim_type  Int     @default(0) // svga|pag|mp4
  anim_url   String  @default("")
  fullscreen Boolean @default(false)
  active     Boolean @default(true)
}

model GiftRecord {
  id         Int      @id @default(autoincrement())
  from_uid   Int
  to_uid     Int
  rid        Int?
  gift_id    Int
  num        Int      @default(1)
  coin_total BigInt   @default(0)
  createdAt  DateTime @default(now())

  @@index([to_uid])
  @@index([rid])
}

model Room {
  rid       Int          @id @default(autoincrement())
  owner_uid Int
  name      String
  roomType  Int          @default(0)
  cover     String       @default("")
  notice    String       @default("")
  tag       String       @default("")
  lock      Int          @default(0)
  seatCount Int          @default(10)
  onlineNum Int          @default(0)
  roomLevel Int          @default(0)
  status    Int          @default(1)
  // room.getCountryRoomListV2 filters and groups on this; without it the
  // country tabs on the Live screen have nothing to select by.
  country   String       @default("")
  createdAt DateTime     @default(now())
  members   RoomMember[]
  seats     Seat[]
}

model RoomMember {
  id       Int      @id @default(autoincrement())
  rid      Int
  uid      Int
  role     String   @default("member")
  joinedAt DateTime @default(now())
  room     Room     @relation(fields: [rid], references: [rid])

  @@unique([rid, uid])
}

model Seat {
  id         Int    @id @default(autoincrement())
  rid        Int
  seatNo     Int
  uid        Int?
  micState   Int    @default(0)
  lock       Int    @default(0)
  charmValue BigInt @default(0)
  room       Room   @relation(fields: [rid], references: [rid])

  @@unique([rid, seatNo])
}

model Guild {
  id        Int           @id @default(autoincrement())
  guild_id  Int           @unique
  name      String
  owner_uid Int
  avatar    String        @default("")
  anchorNum Int           @default(0)
  members   GuildMember[]
}

model GuildMember {
  id       Int      @id @default(autoincrement())
  guild_id Int
  uid      Int
  income   BigInt   @default(0)
  joinedAt DateTime @default(now())
  guild    Guild    @relation(fields: [guild_id], references: [guild_id])

  @@unique([guild_id, uid])
}

model Agency {
  id        Int    @id @default(autoincrement())
  name      String
  owner_uid Int
}

model Cp {
  id          Int      @id @default(autoincrement())
  uid         Int
  target_uid  Int
  sweet_value BigInt   @default(0)
  cp_lv       Int      @default(0)
  days        Int      @default(0)
  hasCp       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([uid, target_uid])
}

model Friend {
  id         Int      @id @default(autoincrement())
  uid        Int
  target_uid Int
  type       String
  createdAt  DateTime @default(now())

  @@unique([uid, target_uid, type])
}

model Message {
  id         Int      @id @default(autoincrement())
  from_uid   Int
  to_uid     Int
  session_id String
  type       Int      @default(0)
  content    String
  createdAt  DateTime @default(now())

  @@index([session_id])
}

model Ranking {
  id         Int      @id @default(autoincrement())
  rank_type  String
  period     String
  uid        Int
  score      BigInt   @default(0)
  rank       Int
  computedAt DateTime @default(now())

  @@index([rank_type, period, rank])
}

model Settings {
  uid                Int @id
  hidden_online      Int @default(0)
  hidden_ranking     Int @default(0)
  hidden_act_ranking Int @default(0)
  refuse_accost      Int @default(0)
}

model Config {
  key   String @id
  value Json
}

// ── catalogue ─────────────────────────────────────────────────────────
// One table backs every cosmetic the app sells or grants: avatar frames,
// chat bubbles, entry effects, ride/car animations, room backgrounds and
// profile themes. The original app exposes these through several different
// actions (mall.*, theme.*, noble frames, VIP frames) but they are the same
// object with a different `type`, so they are unified here and the differing
// actions are kept as thin views over this table. That is what makes them
// manageable from one admin screen.
model MallProduct {
  product_id Int           @id @default(autoincrement())
  type       String // frame | bubble | car | entry | room_bg | theme | medal
  name       String
  icon       String        @default("")
  preview    String        @default("") // svga/pag/mp4 for animated items
  price      Int           @default(0)
  coin_type  Int           @default(1) // 1 coin, 2 diamond
  duration   Int           @default(30) // days; 0 = permanent
  category   Int           @default(0)
  vip_only   Int           @default(0) // minimum vip level, 0 = anyone
  noble_only Int           @default(0) // minimum noble level
  sort       Int           @default(0)
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  owners     UserProduct[]

  @@index([type, active])
}

model UserProduct {
  id         Int         @id @default(autoincrement())
  uid        Int
  product_id Int
  equipped   Boolean     @default(false)
  source     String      @default("buy") // buy | gift | grant | vip | noble
  expireAt   DateTime? // null = permanent
  createdAt  DateTime    @default(now())
  product    MallProduct @relation(fields: [product_id], references: [product_id])

  @@unique([uid, product_id])
  @@index([uid, equipped])
}

// ── notices ───────────────────────────────────────────────────────────
// notice.checkNotice returns unread COUNTS per category, which the client
// renders as the red dots on the Message tab.
model Notice {
  id        Int      @id @default(autoincrement())
  uid       Int
  type      String // system | gift | follow | guild | activity
  title     String   @default("")
  body      String   @default("")
  icon      String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([uid, read])
}

// ── daily sign-in ─────────────────────────────────────────────────────
model SignInReward {
  day         Int    @id // 1..7
  reward_type String @default("coin") // coin | diamond | product
  reward_num  Int    @default(0)
  product_id  Int?
  icon        String @default("")
}

model UserSignIn {
  id       Int      @id @default(autoincrement())
  uid      Int
  day      Int
  ymd      String // YYYY-MM-DD, so a day can only be claimed once
  signedAt DateTime @default(now())

  @@unique([uid, ymd])
  @@index([uid])
}

// ── activity banners ──────────────────────────────────────────────────
model Banner {
  id       Int       @id @default(autoincrement())
  image    String
  link     String    @default("")
  position String    @default("home") // home | room | me
  sort     Int       @default(0)
  active   Boolean   @default(true)
  startAt  DateTime?
  endAt    DateTime?
  clicks   Int       @default(0)

  @@index([position, active])
}

// ── medals ────────────────────────────────────────────────────────────
model Medal {
  medal_id Int     @id @default(autoincrement())
  name     String
  icon     String  @default("")
  desc     String  @default("")
  sort     Int     @default(0)
  active   Boolean @default(true)
}

model UserMedal {
  id       Int       @id @default(autoincrement())
  uid      Int
  medal_id Int
  adorned  Boolean   @default(false)
  expireAt DateTime?
  gotAt    DateTime  @default(now())

  @@unique([uid, medal_id])
}

// ── room collections ──────────────────────────────────────────────────
model RoomCollect {
  id        Int      @id @default(autoincrement())
  uid       Int
  rid       Int
  createdAt DateTime @default(now())

  @@unique([uid, rid])
  @@index([uid])
}

// ── agency / BD invites ───────────────────────────────────────────────
// Action/BDCenter.inviteUserRes is polled by the client for the state of an
// invitation it was shown.
model AgencyInvite {
  id          Int       @id @default(autoincrement())
  agency_id   Int
  uid         Int
  status      Int       @default(0) // 0 pending, 1 accepted, 2 rejected, 3 expired
  invitedBy   Int
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([agency_id, uid])
  @@index([uid, status])
}

// ── room administration ───────────────────────────────────────────────
// Persisted room roles. The gateway keeps live admin state in memory for
// permission checks during a session; this is the durable record behind
// room.addRole / delRole / getRoomManageList, so a grant survives a restart.
model RoomRole {
  id        Int      @id @default(autoincrement())
  rid       Int
  uid       Int
  role      String   @default("admin") // admin | host
  grantedBy Int
  createdAt DateTime @default(now())

  @@unique([rid, uid])
  @@index([rid])
}

model RoomBan {
  id        Int       @id @default(autoincrement())
  rid       Int
  uid       Int
  kind      String    @default("block") // block (banned from room) | mute
  reason    String    @default("")
  by_uid    Int
  expireAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([rid, uid, kind])
  @@index([rid, kind])
}

/// Mic queue — room.getApplyMicList / RoomApi.joinMic.
model MicApply {
  id        Int      @id @default(autoincrement())
  rid       Int
  uid       Int
  seatNo    Int      @default(-1) // -1 = any free seat
  status    Int      @default(0) // 0 pending, 1 accepted, 2 rejected
  createdAt DateTime @default(now())

  @@unique([rid, uid])
  @@index([rid, status])
}

/// Fan-call sessions — RoomApi.startCallFans / cancelCallFans.
model CallFans {
  id        Int       @id @default(autoincrement())
  rid       Int
  uid       Int
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([rid, active])
}

/// User-level block list — report.addBlackList (distinct from a room ban).
model UserBlock {
  id         Int      @id @default(autoincrement())
  uid        Int
  target_uid Int
  createdAt  DateTime @default(now())

  @@unique([uid, target_uid])
  @@index([uid])
}

model Report {
  id         Int      @id @default(autoincrement())
  uid        Int
  target_uid Int?
  rid        Int?
  kind       String   @default("user")
  reason     String   @default("")
  detail     String   @default("")
  status     Int      @default(0) // 0 open, 1 reviewed
  createdAt  DateTime @default(now())

  @@index([status])
}

// ── social feed ───────────────────────────────────────────────────────
model Moment {
  id        Int      @id @default(autoincrement())
  uid       Int
  text      String   @default("")
  images    Json?
  songId    Int?
  topicId   Int?
  likes     Int      @default(0)
  comments  Int      @default(0)
  views     Int      @default(0)
  status    Int      @default(1)
  createdAt DateTime @default(now())

  @@index([uid])
  @@index([topicId])
  @@index([createdAt])
}

model MomentLike {
  id        Int      @id @default(autoincrement())
  moment_id Int
  uid       Int
  createdAt DateTime @default(now())

  @@unique([moment_id, uid])
}

model MomentView {
  id        Int      @id @default(autoincrement())
  moment_id Int
  uid       Int
  createdAt DateTime @default(now())

  @@unique([moment_id, uid])
}

/// Comments on moments AND on bottles, and replies to other comments — the
/// original app has separate list actions for each, but one row shape covers
/// all three: `target_type` says what is being commented on, `parent_id`
/// makes it a reply.
model Comment {
  id          Int      @id @default(autoincrement())
  target_type String   @default("moment") // moment | bottle | comment
  target_id   Int
  parent_id   Int?
  uid         Int
  text        String   @default("")
  praises     Int      @default(0)
  status      Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([target_type, target_id])
  @@index([parent_id])
}

model CommentPraise {
  id         Int      @id @default(autoincrement())
  comment_id Int
  uid        Int
  createdAt  DateTime @default(now())

  @@unique([comment_id, uid])
}

model FeedTopic {
  id        Int      @id @default(autoincrement())
  name      String
  cover     String   @default("")
  desc      String   @default("")
  hot       Int      @default(0)
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ── drift bottles (voice/song clips) ──────────────────────────────────
model Bottle {
  id        Int      @id @default(autoincrement())
  uid       Int
  url       String
  cover     String   @default("")
  title     String   @default("")
  duration  Int      @default(0)
  likes     Int      @default(0)
  plays     Int      @default(0)
  /// 0 pending review, 1 approved, 2 rejected — getUserCensorSongs reads this.
  censor    Int      @default(0)
  status    Int      @default(1)
  createdAt DateTime @default(now())

  @@index([uid, censor])
  @@index([status, createdAt])
}

model BottleLike {
  id        Int      @id @default(autoincrement())
  bottle_id Int
  uid       Int
  createdAt DateTime @default(now())

  @@unique([bottle_id, uid])
  @@index([uid])
}

// ── PK battles ────────────────────────────────────────────────────────
model PkMatch {
  id        Int       @id @default(autoincrement())
  rid_a     Int
  rid_b     Int?
  status    Int       @default(0) // 0 invited, 1 running, 2 finished, 3 refused, 4 cancelled
  score_a   BigInt    @default(0)
  score_b   BigInt    @default(0)
  duration  Int       @default(300)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([rid_a, status])
  @@index([rid_b, status])
}

// ── mini games ────────────────────────────────────────────────────────
model Game {
  game_id  Int     @id @default(autoincrement())
  name     String
  icon     String  @default("")
  url      String  @default("")
  provider String  @default("") // amg | yomi | joyplay
  hot      Int     @default(0)
  sort     Int     @default(0)
  active   Boolean @default(true)
}

model GameRoom {
  id        Int      @id @default(autoincrement())
  game_id   Int
  rid       Int?
  owner_uid Int
  roomCode  String   @unique
  status    Int      @default(1)
  createdAt DateTime @default(now())
}

model GamePlayer {
  id           Int      @id @default(autoincrement())
  game_id      Int
  uid          Int
  score        BigInt   @default(0)
  wins         Int      @default(0)
  plays        Int      @default(0)
  lastPlayedAt DateTime @default(now())

  @@unique([game_id, uid])
  @@index([game_id, score])
}

/// Short-lived tokens handed to third-party game SDKs (MiniGame/JoyPlay).
model GameToken {
  id        Int      @id @default(autoincrement())
  uid       Int
  provider  String
  token     String   @unique
  expireAt  DateTime
  createdAt DateTime @default(now())

  @@index([uid, provider])
}

// ── room events: bombs, lucky bags, rockets ───────────────────────────
model RoomBombConfig {
  id        Int     @id @default(autoincrement())
  name      String
  icon      String  @default("")
  threshold Int     @default(1000)
  prize     Int     @default(0)
  active    Boolean @default(true)
}

model RoomPrizeRecord {
  id        Int      @id @default(autoincrement())
  rid       Int
  uid       Int
  kind      String   @default("bomb") // bomb | luckybag | rocket | luckydraw
  prize     Int      @default(0)
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([rid, kind])
  @@index([uid])
}

model LuckyBag {
  id        Int       @id @default(autoincrement())
  rid       Int
  from_uid  Int
  coins     Int       @default(0)
  count     Int       @default(1)
  taken     Int       @default(0)
  expireAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([rid])
}

model LuckyBagClaim {
  id        Int      @id @default(autoincrement())
  bag_id    Int
  uid       Int
  coins     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([bag_id, uid])
}

/// Rocket gift progress per room — RocketGift.gifts / roomGifts.
model RocketGift {
  id        Int      @id @default(autoincrement())
  rid       Int
  level     Int      @default(1)
  progress  BigInt   @default(0)
  target    BigInt   @default(10000)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([rid])
}

// ── room level / activities ───────────────────────────────────────────
model RoomLevelConfig {
  level   Int    @id
  needExp BigInt @default(0)
  prize   Int    @default(0)
  icon    String @default("")
}

model RoomLevelState {
  rid       Int      @id
  level     Int      @default(1)
  exp       BigInt   @default(0)
  claimed   Json?
  updatedAt DateTime @updatedAt
}

model RoomAct {
  id      Int       @id @default(autoincrement())
  name    String
  cover   String    @default("")
  desc    String    @default("")
  startAt DateTime?
  endAt   DateTime?
  active  Boolean   @default(true)
}

model RoomActJoin {
  id        Int      @id @default(autoincrement())
  act_id    Int
  rid       Int
  uid       Int
  createdAt DateTime @default(now())

  @@unique([act_id, uid])
}

// ── misc reference data ───────────────────────────────────────────────
model CountryZone {
  code String @id // ISO-2
  name String
  zone String // dialling prefix
  flag String @default("")
  sort Int    @default(0)
}

model AppVersion {
  id        Int      @id @default(autoincrement())
  platform  String   @default("android")
  version   String
  build     Int      @default(0)
  url       String   @default("")
  notes     String   @default("")
  force     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([platform, build])
}

/// Room noticeboard/quick-chat phrases and horn broadcasts.
model Horn {
  id        Int      @id @default(autoincrement())
  uid       Int
  rid       Int?
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Photo {
  id        Int      @id @default(autoincrement())
  uid       Int
  url       String
  isDefault Boolean  @default(false)
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([uid])
}

// ═══════════════════════════════════════════════════════════════════════
//  ADMIN / CONTROL PANEL
//  Additive only — no existing model is touched. These back the operator
//  console at /admin; the app's api.php surface never reads them.
// ═══════════════════════════════════════════════════════════════════════

/// A back-office operator. Passwords are scrypt-hashed (salt per user); the
/// plaintext never leaves the login request. `role` gates destructive actions:
/// super can manage other admins, admin manages content/economy, editor is
/// read + content edits only.
model AdminUser {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  passwordHash String
  salt         String
  role         String         @default("admin") // super | admin | editor
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  lastLoginAt  DateTime?
  sessions     AdminSession[]
}

/// A logged-in admin session. The bearer token the console sends is looked up
/// here; expired rows are rejected. Logging out deletes the row.
model AdminSession {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  admin_id  Int
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([token])
}

/// Every uploaded art file. The binary lives on disk under assets/uploads/;
/// this row is the library the asset picker lists, so an admin can reuse an
/// upload across many catalogue rows instead of re-uploading.
model AssetFile {
  id         Int      @id @default(autoincrement())
  path       String   @unique // relative, e.g. uploads/frames/1712.webp
  kind       String   @default("image") // image | svga | pag | mp4 | other
  name       String   @default("")
  size       Int      @default(0)
  uploadedBy Int?
  createdAt  DateTime @default(now())

  @@index([kind])
}

/// Audit trail. Every create/update/delete/toggle through the admin API writes
/// one row, so a change can always be traced to an operator. Read-only from the
/// console.
model AuditLog {
  id        Int      @id @default(autoincrement())
  admin_id  Int
  username  String   @default("")
  action    String // create | update | delete | toggle | login | balance | ...
  entity    String   @default("")
  entity_id String   @default("")
  detail    Json?
  createdAt DateTime @default(now())

  @@index([admin_id])
  @@index([entity])
  @@index([createdAt])
}

/// Wealth-tier thresholds. Per-user wealth lives on the Wealth model; this is
/// the ladder an admin tunes — the app has no table for it yet, so this makes
/// wealth levels manageable rather than hard-coded.
model WealthLevelConfig {
  level   Int    @id
  name    String @default("")
  needExp BigInt @default(0)
